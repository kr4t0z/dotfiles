# Ghostty Configuration - Eye-Saver Optimized
# Two styles: Minimal & Clean, and Ultimate Eye-Saver

# =============================================================================
# SHARED SETTINGS
# =============================================================================

mouse-hide-while-typing = true
clipboard-read = allow
clipboard-paste-protection = false
window-height = 80
window-width = 300
window-vsync = true
keybind = shift+enter=text:\n

