# =============================================================================
# STYLE 2: ULTIMATE EYE-SAVER
# Maximum comfort for long coding sessions
# =============================================================================

# -- THEME --
# Catppuccin Mocha: warm dark theme with muted colors
# Works beautifully on OLED - deep blacks without being pure #000
theme = Catppuccin Mocha

# -- OLED OPTIMIZATION --
# On OLED, we can use slightly lower brightness text
# The true blacks make contrast naturally comfortable

# -- FONT --
# Maple Mono: rounded letterforms reduce sharpness fatigue
# Size 19: large enough to read without squinting
# Not too large to avoid excessive eye movement
font-family = "Maple Mono"
font-size = 19

# -- CURSOR --
# Underline: minimal visual footprint, less distracting than block
# No blink: eliminates repetitive motion that strains peripheral vision
cursor-style = underline
cursor-style-blink = false

# -- WINDOW --
# Full opacity: no background noise bleeding through
# Titlebar on: consistent UI, easy window management
window-decoration = true
background-opacity = 1

# -- SPACING --
# Generous padding: content breathes, reduces claustrophobic feeling
# 24px horizontal: eyes don't track to screen edge
# 20px vertical: comfortable line start position
window-padding-x = 24
window-padding-y = 20

# -- READABILITY --
# Minimum contrast 1.2: ensures text pops without being harsh
# Prevents washed-out text that causes squinting
minimum-contrast = 1.2

# -- FOCUS --
# Dim unfocused splits: reduces visual noise, guides attention
# 0.85 keeps context visible but clearly secondary
unfocused-split-opacity = 0.85

